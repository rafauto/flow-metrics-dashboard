# Copy to .env (or set in your shell / Streamlit Cloud settings). No secrets are required.

# Maximum size of an uploaded CSV, in megabytes.
FLOW_METRICS_MAX_UPLOAD_MB=10

# Maximum number of rows accepted from an uploaded CSV.
FLOW_METRICS_MAX_ROWS=200000

# Optional path to a custom workflow mapping (status -> category). Defaults to the bundled one.
# FLOW_METRICS_WORKFLOW_FILE=examples/workflow.yaml

# Log level for the app and the CLI: DEBUG, INFO, WARNING, ERROR.
FLOW_METRICS_LOG_LEVEL=INFO
